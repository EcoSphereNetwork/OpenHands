# GitHub-Konfiguration für Issue-Resolver
GITHUB_TOKEN=your-github-token
GIT_USERNAME=your-github-username

# Docker-Konfiguration
SANDBOX_RUNTIME_CONTAINER_IMAGE=docker.all-hands.dev/all-hands-ai/runtime:0.31-nikolaik
WORKSPACE_MOUNT_PATH=/opt/workspace_base

# SGLang-Konfiguration
SGLANG_MODEL=Phi3-mini-4k-instruct-gguf  # Standardmodell für SGLang
# Weitere Optionen: llama3-8b-gguf, mistral-7b-instruct-gguf, gemma-7b-instruct-gguf
# Vollständige Liste unter: https://docs.sglang.ai/llms/overview

# Hardware-Konfiguration (optional)
# SGLANG_DEVICE_MAP=cuda:0  # Für spezifische GPU-Auswahl
# SGLANG_NUM_GPUS=1         # Anzahl der zu verwendenden GPUs
