# OpenHands Multi-Modell Konfiguration mit SGLang
# Diese Datei enthält alle Umgebungsvariablen für das Multi-Modell-Setup
# Kopieren Sie diese Datei zu .env und passen Sie die Werte an Ihre Bedürfnisse an

#######################
# MODELL-KONFIGURATION
#######################

# Standard-Modell, das beim Start verwendet wird (1.5B als Standard)
SGLANG_MODEL=all-hands/openhands-lm-1.5b-v0.1
# Alternativen:
# SGLANG_MODEL=all-hands/openhands-lm-7b-v0.1
# SGLANG_MODEL=all-hands/openhands-lm-32b-v0.1

# Vorgeladene Modelle (für schnelleren Wechsel)
# Mehrere Modelle mit Komma trennen, leer lassen für kein Vorladen
SGLANG_PRELOAD_MODELS=all-hands/openhands-lm-1.5b-v0.1

#######################
# OPENHANDS-KONFIGURATION
#######################

# Docker Runtime-Image für die Sandbox
SANDBOX_RUNTIME_CONTAINER_IMAGE=docker.all-hands.dev/all-hands-ai/runtime:0.31-nikolaik

# Workspace-Mount-Pfad
WORKSPACE_MOUNT_PATH=/opt/workspace_base

# OpenAI-API-Key (falls Sie auch OpenAI-Modelle verwenden möchten)
# OPENAI_API_KEY=sk-...

# Anthropic-API-Key (falls Sie auch Anthropic-Modelle verwenden möchten)
# ANTHROPIC_API_KEY=sk-ant-...

#######################
# GITHUB / GITLAB
#######################

# GitHub-Konfiguration für OpenHands Issue-Resolver
GITHUB_TOKEN=your-github-token
GIT_USERNAME=your-github-username

# GitLab-Konfiguration für OpenHands Issue-Resolver
GITLAB_TOKEN=your-gitlab-token
GIT_USERNAME=your-gitlab-username

#######################
# HARDWARE-OPTIMIERUNG
#######################

# Geräte-Konfiguration
# auto: SGLang wählt automatisch das beste Gerät
# cuda:0: Spezifisches CUDA-Gerät auswählen
# balanced: Für Multi-GPU-Setup
SGLANG_DEVICE_MAP=auto

# Anzahl GPUs (nur relevant bei mehreren GPUs)
# SGLANG_NUM_GPUS=1

# Quantisierung aktivieren, um Speicherverbrauch zu reduzieren
# Optionen: none, 8bit, 4bit (4bit empfohlen für 32B auf GPUs mit <24GB VRAM)
# SGLANG_QUANTIZATION=none

# Kontextlänge begrenzen, um Speicher zu sparen (Standard: 8192)
# Kleinere Werte reduzieren Speicherverbrauch, beeinträchtigen aber potentiell die Qualität
SGLANG_MAX_MODEL_LEN=8192

# Für bessere Leistung bei begrenztem VRAM
# true: Inaktive Modelle werden aus dem Speicher entladen
SGLANG_UNLOAD_INACTIVE_MODELS=true

# Speicher nach Verwendung freigeben
# SGLANG_FORCE_RELEASE_MEMORY=false

#######################
# PERFORMANCE-EINSTELLUNGEN
#######################

# Batch-Größe für Inferenz (höhere Werte können Durchsatz verbessern)
# SGLANG_BATCH_SIZE=4

# Disk-Caching für schnelleres Neuladen von Modellen
SGLANG_DISK_CACHE=true

# KV-Cache Precision (fp16 spart Speicher, fp32 ist präziser)
# SGLANG_KV_CACHE_PRECISION=fp16

# Compilation-Parallelismus (kann Startzeit verbessern)
# SGLANG_COMPILATION_PARALLELISM=true

#######################
# SICHERHEIT & FEHLERBEHANDLUNG
#######################

# Safe Mode verhindert Laden zu großer Modelle für verfügbare Hardware
SGLANG_SAFE_MODE=true

# Fallback-Modell, wenn ein Modell nicht geladen werden kann
SGLANG_FALLBACK_MODEL=all-hands/openhands-lm-1.5b-v0.1

#######################
# AUTHENTIFIZIERUNG
#######################

# Hugging Face Token (nur nötig, wenn die Modelle privat sind)
# HF_TOKEN=hf_...

#######################
# LOGGING & DEBUGGING
#######################

# Log-Level (info, debug, warning, error)
# SGLANG_LOG_LEVEL=info

# Debug-Modus aktivieren
# SGLANG_DEBUG=false

